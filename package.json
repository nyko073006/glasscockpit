{
  "name": "glasscockpit",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "description": "Run Claude Code sessions as terminal views with a cockpit dashboard.",
  "author": "nyko073006",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "vitest run",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "deploy:statusline": "node scripts/deploy-statusline.mjs",
    "deploy:hook": "node scripts/deploy-hook.mjs",
    "preview:cockpit": "node scripts/preview-cockpit.mjs",
    "check:public": "node scripts/check-public.mjs",
    "lint:portal": "node scripts/portal-lint.mjs",
    "release": "node scripts/release.mjs",
    "export-public": "node scripts/export-public.mjs",
    "third-party": "node scripts/third-party.mjs",
    "native-checksums": "node scripts/native-checksums.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/language": "6.12.4",
    "@lezer/highlight": "1.2.5",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "obsidian": "1.13.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "node-pty": "1.1.0",
    "ws": "8.22.0"
  }
}
